---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);
const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
const formattedDate = new Intl.DateTimeFormat('es-EC', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
}).format(post.publishDate);
---

<article class="group h-full overflow-hidden rounded-[1.6rem] border border-[#d9b7a4]/60 bg-[#f9efe9] shadow-[0_16px_30px_rgba(117,87,74,0.08)] transition-transform duration-300 hover:-translate-y-1">
  <div class="relative overflow-hidden rounded-t-[1.5rem] bg-[#d6b29c]">
    {
      image ? (
        link ? (
          <a href={link} class="block">
            <Image
              src={image}
              class="h-44 w-full object-cover transition duration-500 group-hover:scale-[1.03]"
              widths={[400, 900]}
              width={900}
              height={506}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              format="webp"
              loading="lazy"
              decoding="async"
            />
          </a>
        ) : (
          <Image
            src={image}
            class="h-44 w-full object-cover transition duration-500 group-hover:scale-[1.03]"
            widths={[400, 900]}
            width={900}
            height={506}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.title}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        )
      ) : (
        <div class="flex h-44 items-center justify-center bg-[radial-gradient(circle_at_center,_rgba(255,255,255,0.2),_rgba(255,255,255,0)_45%)]">
          <div class="flex h-14 w-14 items-center justify-center rounded-full border border-white/60 bg-white/10">
            <div class="h-6 w-6 rounded-full border-2 border-white/80"></div>
          </div>
        </div>
      )
    }
  </div>

  <div class="p-5">
    <p class="mb-3 text-[11px] font-medium uppercase tracking-[0.18em] text-[#5a4237]">{formattedDate}</p>

    <h3 class="mb-2 text-xl font-bold leading-tight text-[#3a2e2b] font-heading">
      {
        link ? (
          <a class="inline-block transition-colors duration-200 hover:text-[#c48776]" href={link}>
            {post.title}
          </a>
        ) : (
          post.title
        )
      }
    </h3>

    {post.excerpt && <p class="text-base leading-relaxed text-[#5a4237]">{post.excerpt}</p>}
  </div>
</article>
