---
import '@fontsource-variable/inter';
---

<style is:inline>
  /* Import Google Fonts for body text. */
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap');

  :root {
    /* Tipografías */
    --aw-font-sans: 'DM Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
    --aw-font-serif: Georgia, 'Times New Roman', Times, serif;
    --aw-font-heading: 'George Town', Georgia, 'Times New Roman', serif;

    /* Design Tokens — Marca PediWell */
    --terracota: #e2a996; /* CTAs, acentos, links activos, íconos */
    --arena: #6e554e; /* fondos de sección alterna en paleta oscura */
    --marron: #7f655e; /* color marrón predominante en todo el proyecto */
    --marron-oscuro: #5c453e; /* marrón profundo para contraste y bandas */
    --marron-suave: #6e554e; /* marrón suave para tarjetas y bloques */
    --rosa: #e0b6a5; /* formas decorativas, hover, quote marks, kickers */
    --gris: #d5b9ad; /* texto secundario, metadatos */
    --fondo-base: #7f655e; /* fondo general del body — #7f655e predominante */
    --ink: #ffffff; /* texto claro para contraste */

    /* Paleta principal mapeada */
    --aw-color-primary: var(--terracota); /* #e2a996 */
    --aw-color-secondary: var(--marron-suave); /* #6e554e */
    --aw-color-accent: #c48776; /* acentos / botones */

    /* Colores secundarios */
    --aw-color-secondary-dark: var(--marron-oscuro); /* #5c453e */
    --aw-color-secondary-mid: var(--rosa); /* #e0b6a5 */
    --aw-color-secondary-light: #8e736b; /* hover / estados suaves */

    /* Complementarios / texto */
    --aw-color-neutral: var(--gris); /* #d5b9ad */
    --aw-color-white: #ffffff;
    --aw-color-dark: var(--ink); /* #ffffff */

    /* AW variables used by Tailwind utilities in the project */
    --aw-color-text-heading: #ffffff;
    --aw-color-text-default: #f2d9cb;
    --aw-color-text-muted: #d5b9ad;
    --aw-color-bg-page: var(--marron); /* #7f655e predominante */
    --aw-color-bg-page-dark: var(--marron-oscuro); /* #5c453e */

    ::selection {
      background-color: var(--rosa);
      color: #3a2e2b;
    }
  }

  :root {
    color-scheme: dark;
  }

  /* Personalizaciones del Footer - Conservando su color original */
  footer {
    background-color: #7f655e;
    color: #f2d9cb;
    border-top-color: rgba(255, 255, 255, 0.15);
    font-size: 0.95rem;
  }

  footer .text-sm {
    font-size: 0.95rem;
  }

  footer .font-medium,
  footer .font-bold,
  footer h1,
  footer h2,
  footer h3,
  footer h4,
  footer h5,
  footer h6 {
    color: var(--aw-color-primary);
    font-size: 1.1rem;
  }

  footer,
  footer a,
  footer .text-muted,
  footer li,
  footer p,
  footer span,
  footer div {
    color: #f2d9cb;
  }

  footer a:hover,
  footer a.text-muted:hover {
    color: #ffffff;
    background-color: transparent;
  }

  /* Local font-face registrations (files provided in src/assets/fonts/) */
  @font-face {
    font-family: 'George Town';
    src: url('/src/assets/fonts/GeorgeTown Display/TTF/GeorgeTown-Regular.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'George Town';
    src: url('/src/assets/fonts/GeorgeTown Display/TTF/GeorgeTown-SemiBold.ttf') format('truetype');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Bochan';
    src: url('/src/assets/fonts/bochan_serif/Bochan Serif.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* Update heading font-family to use local fonts */
  :root {
    --aw-font-heading: 'George Town', Georgia, 'Times New Roman', serif;
  }
</style>
