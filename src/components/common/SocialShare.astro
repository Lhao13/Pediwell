---
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-block' } = Astro.props;
---

<div class={className}>
  <div class="rounded-2xl border border-[#e0b6a5]/50 bg-[#f2d9cb]/10 px-5 py-4 shadow-[0_12px_30px_rgba(0,0,0,0.18)]">
    <span class="mb-3 block text-sm font-bold uppercase tracking-[0.16em] text-[#f2d9cb]">Comparte este artículo</span>
    <div class="flex items-center gap-2">
      <button
        class="ml-2 rtl:ml-0 rtl:mr-2"
        title="Twitter Share"
        aria-label="Compartir en X"
        data-aw-social-share="twitter"
        data-aw-url={url}
        data-aw-text={text}
        ><Icon name="tabler:brand-x" class="h-6 w-6 text-[#e0b6a5] transition-colors hover:text-white" />
      </button>
      <button
        class="ml-2 rtl:ml-0 rtl:mr-2"
        title="Facebook Share"
        aria-label="Compartir en Facebook"
        data-aw-social-share="facebook"
        data-aw-url={url}
        ><Icon name="tabler:brand-facebook" class="h-6 w-6 text-[#e0b6a5] transition-colors hover:text-white" />
      </button>
      <button
        class="ml-2 rtl:ml-0 rtl:mr-2"
        title="Linkedin Share"
        aria-label="Compartir en LinkedIn"
        data-aw-social-share="linkedin"
        data-aw-url={url}
        data-aw-text={text}
        ><Icon name="tabler:brand-linkedin" class="h-6 w-6 text-[#e0b6a5] transition-colors hover:text-white" />
      </button>
      <button
        class="ml-2 rtl:ml-0 rtl:mr-2"
        title="Whatsapp Share"
        aria-label="Compartir por WhatsApp"
        data-aw-social-share="whatsapp"
        data-aw-url={url}
        data-aw-text={text}
        ><Icon name="tabler:brand-whatsapp" class="h-6 w-6 text-[#e0b6a5] transition-colors hover:text-white" />
      </button>
      <button
        class="ml-2 rtl:ml-0 rtl:mr-2"
        title="Email Share"
        aria-label="Compartir por correo"
        data-aw-social-share="mail"
        data-aw-url={url}
        data-aw-text={text}
        ><Icon name="tabler:mail" class="h-6 w-6 text-[#e0b6a5] transition-colors hover:text-white" />
      </button>
    </div>
  </div>
</div>
