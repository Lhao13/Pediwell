---
import type { Stats as Props } from '~/types';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  stats = [],

  id,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />
  <div class="flex flex-wrap justify-center gap-x-10 gap-y-8 text-center">
    {
      stats &&
        stats.map(({ amount, title, icon, iconColor }) => (
          <div class="w-full max-w-[360px] flex-1 basis-[260px] p-4 md:border-r md:border-[#e0b6a5]/20 md:last:border-none intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter">
            <div class="flex items-center justify-center gap-4">
              <div class="text-left">
                {amount && (
                  <div class="font-heading text-white text-[2.6rem] font-bold lg:text-5xl xl:text-6xl">{amount}</div>
                )}
                {title && (
                  <div class="text-sm font-medium uppercase tracking-widest text-[#f2d9cb] lg:text-base">{title}</div>
                )}
              </div>
              {icon && (
                <div class:list={['shrink-0', iconColor ?? 'text-[#e0b6a5]']}>
                  <Icon name={icon} class="h-10 w-10 md:h-12 md:w-12" />
                </div>
              )}
            </div>
          </div>
        ))
    }
  </div>
</WidgetWrapper>
