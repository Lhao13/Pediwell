---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

export interface CardItem {
  title: string;
  description: string;
  image: string;
  link?: string;
  linkText?: string;
}

export interface Props {
  tagline?: string;
  title?: string;
  subtitle?: string;
  items?: Array<CardItem>;
  id?: string;
}

const {
  tagline = 'LO QUE MÁS PIDEN NUESTROS PACIENTES',
  title = 'Tres tratamientos, una misma dedicación',
  subtitle,
  items = [
    {
      title: 'Profilaxis Podal',
      description: 'Prevención y cuidado regular para pies siempre saludables.',
      image: 'https://images.unsplash.com/photo-1519823551278-64ac92734fb1?auto=format&fit=crop&w=600&q=80',
      link: '/servicios',
      linkText: 'Conocer más →',
    },
    {
      title: 'Tratamiento de Hongos',
      description: 'Recupera uñas sanas con protocolos especializados.',
      image: 'https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=600&q=80',
      link: '/servicios',
      linkText: 'Conocer más →',
    },
    {
      title: 'Uñas Encarnadas',
      description: 'Alivio inmediato, tratamiento profesional y sin dolor.',
      image: 'https://images.unsplash.com/photo-1600334129128-685c5582fd35?auto=format&fit=crop&w=600&q=80',
      link: '/servicios',
      linkText: 'Conocer más →',
    },
  ],
  id,
} = Astro.props;
---

<WidgetWrapper id={id} containerClass="max-w-7xl mx-auto py-16 md:py-24 text-center">
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-[#fffaf6] overflow-hidden pointer-events-none">
      <!-- Círculos decorativos orgánicos -->
      <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-[#ffe7d7]/60"></div>
      <div class="absolute -bottom-40 -left-20 w-[500px] h-[500px] rounded-full bg-[#e0b6a5]/20"></div>
    </div>
  </Fragment>

  <div class="relative z-10 max-w-6xl mx-auto px-4">
    {tagline && (
      <p class="text-xs sm:text-sm font-bold tracking-[0.25em] uppercase text-[#c48776] mb-3">
        {tagline}
      </p>
    )}

    {title && (
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-[#3a2e2b] leading-tight font-heading mb-12 max-w-3xl mx-auto">
        {title}
      </h2>
    )}

    {subtitle && (
      <p class="text-lg text-[#5a4237] max-w-2xl mx-auto mb-12 -mt-8 font-medium">
        {subtitle}
      </p>
    )}

    {items && items.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10 items-stretch">
        {items.map(({ title: itemTitle, description, image, link = '/servicios', linkText = 'Conocer más →' }) => (
          <div class="group bg-white rounded-3xl shadow-[0_16px_40px_-12px_rgba(127,101,94,0.18)] overflow-hidden flex flex-col transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_24px_50px_-12px_rgba(127,101,94,0.28)] border border-[#e0b6a5]/20">
            <!-- Imagen con gradiente e información encima -->
            <div class="relative h-56 sm:h-60 w-full overflow-hidden">
              <img
                src={image}
                alt={itemTitle}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <!-- Sombra inferior en la imagen -->
              <div class="absolute inset-0 bg-gradient-to-t from-[#3a2e2b]/85 via-[#3a2e2b]/25 to-transparent"></div>
              
              <!-- Título superpuesto en la esquina inferior izquierda -->
              <h3 class="absolute bottom-4 left-5 right-5 text-left text-white font-extrabold text-xl font-heading leading-snug">
                {itemTitle}
              </h3>
            </div>

            <!-- Cuerpo de la tarjeta -->
            <div class="p-6 flex flex-col flex-grow justify-between text-left bg-white">
              <p class="text-[#5a4237] text-base leading-relaxed mb-6 font-medium">
                {description}
              </p>
              <div>
                <a
                  href={link}
                  class="inline-flex items-center text-[#c48776] hover:text-[#7f655e] font-bold text-sm transition-colors duration-200"
                >
                  {linkText}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</WidgetWrapper>
