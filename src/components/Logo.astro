---
import { SITE } from 'astrowind:config';
import logoPeque from '~/assets/images/logopeque.svg?url';

const siteName = 'PediWell';
---

<div class="flex items-center gap-2 whitespace-nowrap">
  <img src={logoPeque} alt="PediWell logo" class="h-9 w-auto" />
  <span class="self-center text-2xl font-bold text-gray-900 md:text-xl">{siteName}</span>
</div>
