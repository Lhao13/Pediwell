---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import ServiceCards from '~/components/widgets/ServiceCards.astro';
import FAQs from '~/components/widgets/FAQs.astro';

import pataFondo from '~/assets/images/pata-fondorosa.webp?url';
import logopeque from '~/assets/images/logopeque.svg?url';

const metadata = {
  title: 'Servicios de Podología en Cumbayá | PediWell',
  description: 'Servicios de Podología en Cumbayá | PediWell',
};
---

<Layout metadata={metadata}>
  <!-- Widget ******************* -->
  <section
    class="w-full px-4 py-20 flex flex-col items-center text-center bg-no-repeat bg-top bg-cover intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    style={`background-image: url('${pataFondo}');`}
    aria-label="Fondo de pie en tratamiento podológico"
  >
    <!-- Overlay / Fader negro transparente de izquierda a derecha -->
    <div
      class="pointer-events-none absolute inset-0 z-15 bg-gradient-to-r from-[#5c453e]/75 via-[#7f655e]/10 hidden md:block"
    >
    </div>
    <div
      class="relative z-20 mx-auto flex h-full w-full items-stretch justify-between px-6 sm:px-10 lg:px-16 py-8 md:py-12 max-w-7xl"
    >
      <div class="grid grid-cols-1 md:grid-cols-12 gap-20 md:gap-16 items-stretch w-full h-full py-4">
        <!-- Columna 1: Parte superior izquierda (más ancha: 7 de 12 columnas) -->
        <div
          class="md:col-span-7 flex flex-col items-start justify-start text-left max-w-2xl z-20 self-start pt-4 md:pt-8 intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade animate-[slideInLeft]"
        >
          <span class="text-base sm:text-lg font-bold tracking-wide uppercase text-[#e0b6a5] mb-2"> Servicios </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#ffffff] leading-tight mb-4">
            Encuentra el tratamiento que tus pies necesitan
          </h1>
          <p class="text-base sm:text-lg text-[#dfcfc7] mb-8 font-medium leading-relaxed">
            Desde el cuidado preventivo hasta tratamientos especializados — todo con el mismo estándar profesional, para
            toda la familia.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section with background nudo2 decoration -->
  <WidgetWrapper id="services-section-bg" containerClass="relative overflow-hidden py-12 md:py-16">
    <Fragment slot="bg">
      <div class="absolute inset-0 overflow-hidden bg-[#5c453e]">
        <img
          src={logopeque}
          alt="Decoración de fondo"
          aria-hidden="true"
          class="absolute inset-0 w-full h-full object-cover object-center opacity-25 pointer-events-none select-none"
        />
      </div>
    </Fragment>

    <div class="relative z-10 mx-auto mb-6 max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <p class="mb-2 text-sm font-semibold uppercase tracking-[0.28em] text-[#e0b6a5] sm:text-base">MÁS SOLICITADOS</p>
      <h2 class="font-heading text-4xl font-black tracking-tight text-white sm:text-5xl">
        Nuestros tratamientos prioritarios
      </h2>
    </div>

    <!-- Profilaxis Podal -->
    <Content
      id="profilaxis-podal"
      columns={0}
      items={[]}
      isReversed={true}
      classes={{ container: 'py-4 md:py-6 lg:py-6' }}
      image={{
        src: 'https://images.pexels.com/photos/9483564/pexels-photo-9483564.jpeg' /*imagen de prueba*/,
        alt: 'Tratamiento de hongos en uñas - PediWell',
      }}
      callToAction={{
        text: 'Agendar profilaxis →',
        href: 'https://wa.me/593999000656?text=Hola%2C%20quiero%20agendar%20una%20cita%20para%20profilaxis%20podal',
        variant: 'primary',
      }}
    >
      <Fragment slot="bg">
        <div class="absolute inset-0 bg-transparent"></div>
      </Fragment>
      <Fragment slot="content">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl mb-4 font-heading">Profilaxis Podal</h2>
        <p class="text-[#f2d9cb] text-lg mb-4">
          Prevención y cuidado regular para pies siempre saludables. Eliminamos callosidades y durezas antes de que se
          conviertan en un problema, con instrumental especializado y un enfoque personalizado.
        </p>
      </Fragment>
    </Content>

    <!-- Tratamiento de Hongos -->
    <Content
      id="tratamiento-hongos"
      columns={0}
      items={[]}
      isAfterContent={true}
      classes={{ container: 'py-4 md:py-6 lg:py-6' }}
      image={{
        src: 'https://images.unsplash.com/photo-1786557747825-48f4b25dbeb8?q=80&w=774&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D' /*imagen de prueba*/,
        alt: 'Tratamiento de hongos en uñas - PediWell',
      }}
      callToAction={{
        text: 'Agendar diagnóstico →',
        href: 'https://wa.me/593999000656?text=Hola%2C%20quiero%20agendar%20una%20cita%20para%20tratamiento%20de%20hongos',
        variant: 'primary',
      }}
    >
      <Fragment slot="bg">
        <div class="absolute inset-0 bg-transparent"></div>
      </Fragment>
      <Fragment slot="content">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl mb-4 font-heading">
          Tratamiento de Hongos
        </h2>
        <p class="text-[#f2d9cb] text-lg mb-4">
          Diagnosticamos el tipo de infección y aplicamos un protocolo adaptado a la severidad de cada caso, con
          seguimiento hasta la recuperación completa de tus uñas.
        </p>
      </Fragment>
    </Content>

    <!-- Uñas Encarnadas -->
    <Content
      id="unas-encarnadas"
      columns={0}
      items={[]}
      isReversed={true}
      isAfterContent={true}
      classes={{ container: 'py-4 md:py-6 lg:py-6' }}
      image={{
        src: 'https://images.unsplash.com/photo-1633526543913-d30e3c230d1f?q=80&w=1740&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D' /*imagen de prueba*/,
        alt: 'Tratamiento de hongos en uñas - PediWell',
      }}
      callToAction={{
        text: 'Agendar cita →',
        href: 'https://wa.me/593999000656?text=Hola%2C%20quiero%20agendar%20una%20cita%20para%20uñas%20encarnadas',
        variant: 'primary',
      }}
    >
      <Fragment slot="bg">
        <div class="absolute inset-0 bg-transparent"></div>
      </Fragment>
      <Fragment slot="content">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl mb-4 font-heading">Uñas Encarnadas</h2>
        <p class="text-[#f2d9cb] text-lg mb-4">
          Resolvemos el problema desde la raíz, con técnicas que evitan la recurrencia y priorizan tu comidad. Alivio
          inmediato, sin dolor, desde la primera sesión.
        </p>
      </Fragment>
    </Content>
  </WidgetWrapper>

  <!-- ServiceCards Widget ****************** -->
  <ServiceCards
    tagline="CATÁLOGO COMPLETO"
    title="Todos nuestros servicios"
    items={[
      {
        title: 'Podología General',
        description: 'Revisión completa, corte y fresado de uñas para una salud podal óptima.',
        image:
          'https://images.unsplash.com/photo-1545463913-5083aa7359a6?q=80&w=1444&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
      },
      {
        title: 'Quiropodia',
        description: 'Eliminación indolora de callosidades y helomas con instrumental estéril.',
        image: 'https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=1200&q=80',
      },
      {
        title: 'Pie Diabético',
        description: 'Control preventivo y curas especializadas para pacientes diabéticos.',
        image: 'https://images.pexels.com/photos/5793925/pexels-photo-5793925.jpeg',
      },
      {
        title: 'Plantillas a Medida',
        description: 'Estudio biomecánico de la pisada y soportes plantares personalizados.',
        image:
          'https://images.unsplash.com/photo-1662135426497-eaa054ba53a3?q=80&w=1740&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
      },
      {
        title: 'Podología Deportiva',
        description: 'Prevención y tratamiento de lesiones por sobrecarga y fascitis plantar.',
        image: 'https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?auto=format&fit=crop&w=1200&q=80',
      },
      {
        title: 'Atención a Domicilio',
        description: 'Servicio en casa para personas mayores o con movilidad reducida.',
        image: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=1200&q=80',
      },
    ]}
  />

  <FAQs
    title="Resolvemos tus dudas"
    subtitle="Preguntas frecuentes"
    items={[
      {
        title: '¿Cuánto dura una sesión?',
        description: 'Depende del tratameiento, pero la mayoría de las sesiones duran entre 30 y 45 minutos.',
        icon: 'tabler:clock',
      },
      {
        title: '¿Necesito referencia médica?',
        description: 'No, puedes agendar directamente con nosotros para cualquier de nuestros servicios',
        icon: 'tabler:stethoscope',
      },
      {
        title: '¿Aceptan seguros?',
        description: 'Consulta por Whatsapp - te confirmamos convenios vigentes segun tu aseguradora',
        icon: 'tabler:key',
      },
    ]}
  />

  <!-- Section ************** -->
  <section
    class="relative w-full px-4 py-50 flex flex-col items-center text-center bg-no-repeat bg-top bg-cover intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    style="background-image: url('/src/assets/images/pata-fondorosa.webp');"
  >
    <div
      class="pointer-events-none absolute inset-0 z-15 bg-gradient-to-r from-[#5c453e]/95 via-[#7f655e]/10 hidden md:block"
    >
    </div>
    <div class="relative z-10 max-w-3xl mx-auto">
      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-white font-heading">
        ¿Cuál de estos tratamientos necesitas hoy?
      </h2>
      <a
        href="https://wa.me/593999000656?text=Hola%2C%20quiero%20agendar%20una%20cita"
        class="inline-block px-8 py-3.5 bg-[#e2a996] text-white font-semibold rounded-full hover:bg-[#c48776] shadow-lg shadow-[#e2a996]/20 transition-all duration-300"
        >Reservar cita</a
      >
    </div>
  </section>
</Layout>
