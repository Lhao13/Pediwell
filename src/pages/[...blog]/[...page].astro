---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import Grid from '~/components/blog/Grid.astro';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

// const allCategories = await findCategories();
// const allTags = await findTags();

const metadata = {
  title: `Blog${currentPage > 1 ? ` — Página ${currentPage}` : ''}`,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <section
    class="w-full px-4 py-20 flex flex-col items-center text-center bg-no-repeat bg-top bg-cover intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    style="background-image: url('/src/assets/images/pata-fondorosa.webp');"
    aria-label="Fondo de pie en tratamiento podológico"
  >
    <!-- Overlay / Fader negro transparente de izquierda a derecha -->
    <div class="pointer-events-none absolute inset-0 z-15 bg-gradient-to-r from-black/70 via-black/10 to-transparent">
    </div>
    <div
      class="relative z-20 mx-auto flex h-full w-full items-stretch justify-between px-6 sm:px-10 lg:px-16 py-8 md:py-12 max-w-7xl"
    >
      <div class="grid grid-cols-1 md:grid-cols-12 gap-20 md:gap-16 items-stretch w-full h-full py-4">
        <!-- Columna 1: Parte superior izquierda (más ancha: 7 de 12 columnas) -->
        <div
          class="md:col-span-7 flex flex-col items-start justify-start text-left max-w-2xl z-20 self-start pt-4 md:pt-8 intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade animate-[slideInLeft]"
        >
          <span class="text-base sm:text-lg font-bold tracking-wide uppercase text-[#e0b6a5] mb-2"> Blog </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#ffffff] leading-tight mb-4">
            Consejos para el cuidado de tus pies
          </h1>
          <p class="text-base sm:text-2xl text-[#dfcfc7] mb-8 font-medium leading-relaxed">
            Contenido real del equipo de PediWell - nada de articulos genéricos de plantilla
          </p>
        </div>
      </div>
    </div>
  </section>

    <div class="bg-[#f4efe9] py-16 md:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <Grid posts={page.data} />
      </div>
    </div>

</Layout>
