---
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Quiénes Somos',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Quiénes Somos"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Equipo de Trabajo Caos',
    }}
  >
    <Fragment slot="title">
      Creamos experiencias digitales <br />
      <span class="text-accent"> modernas y eficientes</span>
    </Fragment>

    <Fragment slot="subtitle">
      Somos un equipo apasionado por el desarrollo web y el diseño interactivo. Creemos que cada marca merece una
      presencia en línea que combine una estética atractiva con un rendimiento técnico impecable. Nos dedicamos a
      transformar tus ideas en soluciones digitales reales y escalables.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Nuestra trayectoria en números"
    stats={[
      { title: 'Años de Experiencia', amount: '10+' },
      { title: 'Paciente Atendidos', amount: '2000+' },
      { title: 'Satisfaccion Promedio', amount: '4.9 ⭐' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Nuestras Especialidades"
    subtitle="Nos enfocamos en las áreas críticas para que tu negocio destaque en internet."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Desarrollo Frontend',
        description:
          'Interfaces modernas, interactivas y rápidas utilizando las tecnologías de vanguardia en el desarrollo web actual.',
        icon: 'tabler:template',
      },
      {
        title: 'Diseño UI/UX',
        description:
          'Diseñamos experiencias centradas en el usuario final, asegurando que la navegación sea intuitiva y agradable.',
        icon: 'tabler:template',
      },
      {
        title: 'Posicionamiento SEO',
        description:
          'Estructuramos tu sitio web para asegurar que los motores de búsqueda indexen y valoren tu contenido positivamente.',
        icon: 'tabler:template',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'Comercio Electrónico',
        description:
          'Creamos tiendas online seguras y optimizadas para facilitar la compra y gestión de tus productos.',
        icon: 'tabler:template',
      },
      {
        title: 'Sitios Estáticos (SSG)',
        description:
          'Compilación estática moderna para garantizar que tus páginas carguen instantáneamente desde cualquier lugar del mundo.',
        icon: 'tabler:template',
      },
      {
        title: 'Mantenimiento Continuo',
        description:
          'Nos encargamos de las actualizaciones y el monitoreo para que te enfoques únicamente en hacer crecer tu negocio.',
        icon: 'tabler:template',
      },
      {
        title: 'Identidad Corporativa',
        description:
          'Ayudamos a definir la paleta de colores, tipografías y el estilo visual general que representará a tu marca en línea.',
        icon: 'tabler:template',
      },
      {
        title: 'Optimización de Carga',
        description:
          'Analizamos y mejoramos sitios web existentes para reducir sus tiempos de carga e incrementar sus conversiones.',
        icon: 'tabler:template',
      },
      {
        title: 'Consultoría Digital',
        description:
          'Te asesoramos en la elección de tecnologías y la planificación estratégica para tus próximos proyectos digitales.',
        icon: 'tabler:template',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Espacio de trabajo moderno',
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Nuestros Valores"
    subtitle="La base sobre la cual construimos cada línea de código y cada relación con nuestros clientes."
    items={[
      {
        title: 'Enfoque en el Cliente',
        description:
          'Tus metas de negocio son nuestra prioridad. Trabajamos en estrecha colaboración para asegurar que el resultado final supere tus expectativas.',
      },
      {
        title: 'Mejora Continua',
        description:
          'El ecosistema web evoluciona rápido y nosotros también. Implementamos constantemente las mejores y más modernas prácticas de la industria.',
      },
      {
        title: 'Transparencia',
        description:
          'Mantenemos una comunicación clara y honesta durante todas las etapas de desarrollo del proyecto, sin sorpresas ni costes ocultos.',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Nuestra Filosofía de Trabajo"
    subtitle="Creemos en el trabajo bien hecho y en la entrega de valor constante en cada fase del desarrollo."
    isReversed={true}
    callToAction={{
      text: 'Ver proyectos',
      href: '/blog',
    }}
    items={[
      {
        title: 'Trabajo Remoto y Colaborativo',
        description:
          'Colaboramos en entornos distribuidos de forma ágil y coordinada para optimizar los tiempos de entrega.',
        icon: 'tabler:globe',
      },
      {
        title: 'Atención al Detalle',
        description:
          'Desde el contraste de colores hasta la accesibilidad web, cuidamos cada elemento técnico y estético.',
        icon: 'tabler:message-star',
      },
      {
        title: 'Pasión por la Calidad',
        description:
          'No nos conformamos con que funcione; buscamos la máxima eficiencia en rendimiento y el código más limpio posible.',
        icon: 'tabler:award',
      },
    ]}
  />
</Layout>
