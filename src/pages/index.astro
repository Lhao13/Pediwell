---
import Layout from '~/layouts/PageLayout.astro';

import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import ServiceCards from '~/components/widgets/ServiceCards.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Map from '~/components/widgets/Map.astro';

import nudo from '~/assets/images/nudo2.svg?url';
import pata from '~/assets/images/pata.webp?url';
import pataFondo from '~/assets/images/pata-fondorosa.webp?url';
import logoPedi from '~/assets/images/logo pedi.svg?url';
import whatsappIcon from '~/assets/images/whastapp.svg?url';
const metadata = {
  title: 'PediWell — Clínica Podológica Premium en Cumbayá',
  description:
    'Cuidado experto para tus pies en Cumbayá. Profilaxis podal, tratamiento de hongos y uñas encarnadas con equipo colegiado. Agenda por WhatsApp.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section
    class="relative isolate overflow-hidden bg-[#c8ab9f] h-[100vh] max-h-[1100px] min-h-[600px] flex items-center justify-center"
  >
    <img
      src={nudo}
      alt="Decoración de fondo"
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      sizes="100vw"
      class="hero-deco pointer-events-none absolute inset-0 z-0 h-full w-full object-cover opacity-60"
    />

    <img
      src={pata}
      alt="Pie y planta del pie en tratamiento podológico"
      width="1000"
      height="1000"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-pie pointer-events-none absolute top-0 left-0 z-10 hidden lg:block h-[115%] w-auto max-w-none object-contain object-left-top opacity-90"
    />

    <!-- Overlay / Fader negro transparente de izquierda a derecha -->
    <div class="pointer-events-none absolute inset-0 z-15 bg-gradient-to-r from-black/30 via-black/5 to-transparent">
    </div>

    <div
      class="relative z-20 mx-auto flex h-full w-full items-center justify-center px-6 sm:px-10 lg:px-16 py-8 md:py-12 max-w-5xl"
    >
      <div class="flex flex-col items-center justify-center text-center max-w-3xl w-full z-20">
        <div
          class="hero-logo-box flex flex-col items-center justify-center bg-[#f3d8c5]/80 backdrop-blur-sm rounded-3xl px-8 py-6 sm:px-12 sm:py-8 border border-[#f3d8c5]/40 w-full max-w-2xl my-4 sm:my-6"
        >
          <span class="text-base sm:text-lg font-bold tracking-wide uppercase text-[#5d4f4a] mb-2 sm:mb-3">
            Clínica podológica premium · Cumbayá
          </span>

          <h1 class="flex justify-center items-center w-full">
            <span class="sr-only">PediWell — Clínica Podológica Premium en Cumbayá</span>
            <img
              src={logoPedi}
              alt="Logo Pediwell"
              width="750"
              height="325"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-auto object-contain"
            />
          </h1>
        </div>

        <div class="hero-buttons flex flex-wrap gap-4 items-center justify-center mt-4">
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-full bg-[#CEAB9D] px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-[#CEAB9D]/30 transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#c49886]"
          >
            Reservar citas
          </a>
          <a
            href="https://wa.me/593999000656"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-[#25D366] px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-[#25D366]/20 transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#20ba5a]"
          >
            <img src={whatsappIcon} alt="WhatsApp" class="w-5 h-5 brightness-0 invert" />
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .hero-logo-box {
      animation: fadeIn 1.2s ease-out 0.25s both;
      transition: transform 300ms ease-in-out;
      cursor: pointer;
      filter: drop-shadow(0 0 8px #ece0d8);
    }

    .hero-buttons {
      position: relative;
      z-index: 30;
    }

    .hero-pie {
      animation: slideInLeft 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
      object-position: left center;
      transition:
        transform 300ms ease-in-out,
        filter 300ms ease-in-out;
      cursor: pointer;
    }

    .hero-deco {
      animation: slideInRight 1.1s ease-out 0.15s both;
      transition:
        transform 300ms ease-in-out,
        opacity 300ms ease-in-out;
      cursor: pointer;
    }

    .hero-pie:hover,
    .hero-logo-box:hover,
    .hero-deco:hover {
      transform: scale(1.03);
    }

    @keyframes slideInLeft {
      0% {
        opacity: 0;
        transform: translateX(-80px) scale(0.92);
      }
      100% {
        opacity: 1;
        transform: translateX(0) scale(1);
      }
    }

    @keyframes slideInRight {
      0% {
        opacity: 0;
        transform: translateX(60px) scale(0.96);
      }
      100% {
        opacity: 1;
        transform: translateX(0) scale(1);
      }
    }

    @keyframes fadeIn {
      0% {
        opacity: 0;
      }
      100% {
        opacity: 1;
      }
    }
  </style>
  <script>
    const logoBox = document.querySelector<HTMLElement>('.hero-logo-box');
    const heroButtons = document.querySelector<HTMLElement>('.hero-buttons');
    const heroSection = document.querySelector<HTMLElement>('section');
    const handleScroll = () => {
      const heroHeight = heroSection ? heroSection.offsetHeight : 0;
      const scroll = Math.min(window.scrollY, heroHeight);
      const progress = heroHeight ? scroll / heroHeight : 0;
      if (logoBox) {
        logoBox.style.transform = `translateY(${progress * 100}px)`;
        logoBox.style.opacity = `${1 - progress}`;
      }
      if (heroButtons) {
        heroButtons.style.opacity = `${1 - progress}`;
      }
    };
    window.addEventListener('scroll', handleScroll);
  </script>

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Años de Experiencia', amount: '10+', icon: 'tabler:calendar', iconColor: 'text-[#e2a996]' },
      { title: 'Paciente Atendidos', amount: '2000+', icon: 'tabler:users', iconColor: 'text-[#80d6c2]' },
      { title: 'Satisfaccion Promedio', amount: '4.9', icon: 'tabler:star-filled', iconColor: 'text-yellow-400' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#6e554e] border-y border-[#e0b6a5]/15"></div>
    </Fragment>
  </Stats>

  <!-- Content Widget ************** -->

  <Content
    id="about-me"
    columns={0}
    items={[]}
    image={{
      src: 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRpSuPReEX0xxDwW6gNSH5jonNsQQjx2e54PVTLVv2pYjzcpAX0OxMOfRI&s=10' /*imagen de prueba*/,
      alt: 'Especialista podológica en Pediwell',
    }}
  >
    <Fragment slot="content">
      <p class="text-muted font-medium mb-2">Quienes Somos</p>
      <h2 class="text-3xl font-bold tracking-tight text-heading sm:text-4xl mb-4 font-heading">
        Rigor profesional, trato humano
      </h2>
      <p class="text-muted text-lg mb-4">
        En PediWell creemos que el cuidado de tus pies va más allá de un tratamiento: es bienestar, movilidad y
        confianza en cada paso. Combinamos un equipo colegiado encon una atención cercana, donde te conocemos por tu
        nombre - no por un número de turno.
      </p>
    </Fragment>
  </Content>

  <!--Servicard WIDGET ***************** -->

  <ServiceCards
    tagline="LO QUE MÁS PIDEN NUESTROS PACIENTES"
    title="Tres tratamientos, una misma dedicación"
    items={[
      {
        title: 'Profilaxis Podal',
        description: 'Prevención y cuidado regular para pies siempre saludables.',
        image:
          'https://images.unsplash.com/photo-1638859460750-181fcc7936a6?q=80&w=1548&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
        link: '/que-es-la-profilaxis-podal-y-cada-cuanto-se-recomienda',
        linkText: 'Conocer más →',
      },
      {
        title: 'Tratamiento de Hongos',
        description: 'Recupera uñas sanas con protocolos especializados.',
        image: 'https://images.pexels.com/photos/8832185/pexels-photo-8832185.jpeg',
        link: '/como-prevenir-hongos-en-las-unas-de-los-pies',
        linkText: 'Conocer más →',
      },
      {
        title: 'Uñas Encarnadas',
        description: 'Alivio inmediato, tratamiento profesional y sin dolor.',
        image: 'https://images.pexels.com/photos/17056219/pexels-photo-17056219.jpeg',
        link: '/unas-encarnadas',
        linkText: 'Conocer más →',
      },
    ]}
  />

  <!--Testimonials WIDGET ***************** -->

  <section class="bg-(--aw-color-secondary) py-16">
    <Testimonials
      id="testimonials"
      tagline="Testimonios"
      title="Lo que dicen quienes ya nos visitaron"
      subtitle=""
      testimonials={[
        {
          title: '',
          testimonial:
            'Excelente atención, el tratamiento para mi uña encarnada fue rápido y sin dolor. Muy recomendados',
          name: '- María F.',
          job: 'Cliente satisfecho',
          image: '',
          rating: 5,
        },
        {
          title: '',
          testimonial: 'El equipo es súper cercano y profesional. Se nota la diferencia desde que entras a la clínica',
          name: '- Andrés P.',
          job: 'Cliente feliz',
          image: '',
          rating: 4,
        },
        {
          title: '',
          testimonial: 'Voy cada dos meses a mi sesión de profilaxis y siempre salgo feliz. 100% recomendado.',
          name: '- Carolina S.',
          job: 'Cliente frecuente',
          image: '',
          rating: 5,
        },
      ]}
    />
  </section>

  <!--Map WIDGET ***************** -->

  <Map />

  <!-- Section ************** -->
  <section
    class="relative w-full px-4 py-50 flex flex-col items-center text-center bg-no-repeat bg-top bg-cover intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    style={`background-image: url('${pataFondo}');`}
    aria-label="Fondo de pie en tratamiento podológico"
  >
    <div
      class="pointer-events-none absolute inset-0 z-15 bg-gradient-to-r from-[#5c453e]/50 via-[#7f655e]/10 hidden md:block"
    >
    </div>
    <div class="relative z-10 max-w-3xl mx-auto">
      <h2 class="text-4xl md:text-6xl font-bold mb-6 text-white font-heading">
        ¿Listo para darle a tus pies el cuidado que merecen?
      </h2>
      <a
        href="https://wa.me/593999000656?text=Hola%2C%20quiero%20reservar%20una%20cita%20en%20PediWell"
        class="inline-block px-8 py-3.5 bg-[#e2a996] text-white font-semibold rounded-full hover:bg-[#c48776] shadow-lg shadow-[#e2a996]/20 transition-all duration-300"
        >Reservar cita</a
      >
    </div>
  </section>
</Layout>
